{
  "name": "afterbattle",
  "version": "1.0.0-beta.4",
  "private": true,
  "description": "Local, privacy-first World of Tanks session tracker and deterministic coach.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "lint": "node tools/lint/node_modules/eslint/bin/eslint.js --config tools/lint/eslint.config.js src && prettier --check src/",
    "lint:setup": "pnpm --dir tools/lint install --ignore-workspace --frozen-lockfile",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
